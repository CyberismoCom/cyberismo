% model
% note: not escaped
{{{model}}}

% include the view:
{{{view}}}

selectAll.

result(result).

% We need to format the label attributes without double quotes,
% because labels already use HTML < and >, but we'll enclose other
% attributes in double quotes, so here is a helper term to identify label attributes:
labelAttribute("label").
labelAttribute(label).

% top-level graph
childResult(result, Graph, "digraphs") :-
    graph(Graph).

childResult(Graph, ((graph, Graph), Field), "attrs") :-
    graph(Graph),
    attr(graph, Graph, Field, _).

% "attr"/"value" name the attr/4 tuple's own field and value for output --
% not schema field names, so they never resolved a dataType via the old
% field/3 lookup: shortText is what showed before and is supplied directly
% now. Same reasoning for "isGraph"/"isNode"/"cardKey"/"rank"/"source"/
% "destination" below.
resultField(((graph, Graph), Field), "attr", Field, "shortText") :-
    graph(Graph),
    attr(graph, Graph, Field, _).

resultField(((graph, Graph), Field), "value", Value, "shortText") :-
    graph(Graph),
    attr(graph, Graph, Field, Value),
    labelAttribute(Field).

resultField(((graph, Graph), Field), "value", Value, "shortText") :-
    graph(Graph),
    attr(graph, Graph, Field, Value),
    not labelAttribute(Field).

% subgraphs
childResult(Parent, Graph, "children") :-
    graph(Graph, Parent).

resultField(Graph, "isGraph", "void", "shortText") :-
    childResult(_, Graph, "children"),
    graph(Graph, _).

childResult(Graph, ((graph, Graph), Field), "attrs") :-
    graph(Graph, _),
    attr(graph, Graph, Field, _).

resultField(((graph, Graph), Field), "attr", Field, "shortText") :-
    graph(Graph, _),
    attr(graph, Graph, Field, _).

resultField(((graph, Graph), Field), "value", Value, "shortText") :-
    graph(Graph, _),
    attr(graph, Graph, Field, Value),
    labelAttribute(Field).

resultField(((graph, Graph), Field), "value", Value, "shortText") :-
    graph(Graph, _),
    attr(graph, Graph, Field, Value),
    not labelAttribute(Field).

% nodes

% TODO: For some reason, we need to use (node, Node) instead of Node, or
% the solving will not succeed

resultField((node, Node), "rank", Rank, "shortText") :- field(Node, "rank", Rank), node(Node, _).

resultField((node, Node), "isNode", "void", "shortText") :-
    childResult(_, (node, Node), "children"),
    node(Node, _).

childResult(Graph, (node, Node), "children") :-
    childResult(_, Graph, _),
    node(Node, Graph).

resultField((node, Node), "cardKey", Node, "shortText") :-
    childResult(_, Graph, _),
    node(Node, Graph).

childResult((node, Node), ((node, Node), Field), "attrs") :-
    node(Node, Graph),
    attr(node, Node, Field, _).

resultField(((node, Node), Field), "attr", Field, "shortText") :-
    node(Node, Graph),
    attr(node, Node, Field, _).

resultField(((node, Node), Field), "value", Value, "shortText") :-
    node(Node, Graph),
    attr(node, Node, Field, Value),
    labelAttribute(Field).

resultField(((node, Node), Field), "value", Value, "shortText") :-
    node(Node, Graph),
    attr(node, Node, Field, Value),
    not labelAttribute(Field).

% default graph
graph(default) :-
    node(_).

graph(default) :-
    edge(_).

node(X, default) :-
    node(X).

edge((XR, YR), default) :-
    edge((XR, YR)).

edge((XR, YR, Identifier), default) :-
    edge((XR, YR, Identifier)).

% edges
childResult(Graph, (edge, (XR, YR, Description)), "edges") :-
    childResult(_, Graph, _),
    edge((XR, YR, Description), Graph).

childResult((edge, (XR, YR, Description)), ((edge, (XR, YR, Description)), Field), "attrs") :-
    childResult(_, (edge, (XR, YR, Description)), _),
    attr(edge, (XR, YR, Description), Field, _).

resultField(((edge, (XR, YR, Description)), Field), "attr", Field, "shortText") :-
    childResult(_, (edge, (XR, YR, Description)), _),
    attr(edge, (XR, YR, Description), Field, Value).

resultField(((edge, (XR, YR, Description)), Field), "value", Value, "shortText") :-
    childResult(_, (edge, (XR, YR, Description)), _),
    attr(edge, (XR, YR, Description), Field, Value).

resultField((edge, (XR, YR, Description)), "source", XR, "shortText") :-
    edge((XR, YR, Description), _).

resultField((edge, (XR, YR, Description)), "destination", YR, "shortText") :-
    edge((XR, YR, Description), _).

% edges without a separate identifier use "" as their identifier
edge((XR, YR, ""), Graph) :-
    edge((XR, YR), Graph).

attr(edge, (Source, Destination, ""), Attribute, Value) :-
  attr(edge, (Source, Destination), Attribute, Value).

order(N, Collection, 1, "rank", "ASC") :- resultLevel(_, N, Collection).