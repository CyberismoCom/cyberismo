exports[`create project > refuses a resource named as a projects resource name 1`] = `
{
  "code": 1,
  "stderr": "Input validation error: invalid project name 'gold/projects/golden'
",
  "stdout": "",
}
`;

exports[`create project > refuses a resource named as project 1`] = `
{
  "code": 1,
  "stderr": "Input validation error: prefix must be from 3 to 10 characters long. 'undefined' does not fulfill the condition.
",
  "stdout": "",
}
`;

exports[`create project > refuses an invalid prefix, creating nothing 1`] = `
{
  "code": 1,
  "stderr": "Input validation error: prefix must be from 3 to 10 characters long. 'G!' does not fulfill the condition.
",
  "stdout": "",
}
`;

