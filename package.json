{
  "name": "@cyberismo/cyberismo",
  "description": "Cards: a Tool for Managing Cybersecurity in Software",
  "version": "0.0.1",
  "bin": {
    "cyberismo": "tools/cli/bin/run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@typescript-eslint/parser": "^8.65.0",
    "chokidar-cli": "^3.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-promise": "^7.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-sort-json": "^4.1.1",
    "shx": "^0.4.0",
    "tsx": "^4.23.1",
    "typescript": "^6",
    "typescript-eslint": "^8.65.0",
    "vitest": "~4.1.10",
    "vitest-browser-react": "^2.1.0"
  },
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r run build",
    "clean": "rm -rf node_modules && pnpm -r run clean",
    "lint": "pnpm -r run lint",
    "test": "pnpm test-migrations && pnpm test-data-handler && pnpm test-cli && pnpm test-app && pnpm test-backend && pnpm test-clingo && pnpm test-mcp",
    "test-app": "pnpm --filter app test",
    "test-cli": "pnpm --filter cli test",
    "bump-version": "pnpm -r --filter '!app' --filter '!node-clingo' exec npm version",
    "bump-clingo": "pnpm --filter @cyberismo/node-clingo bump-version",
    "test-data-handler": "pnpm --filter data-handler test",
    "test-migrations": "pnpm --filter migrations test",
    "test-backend": "pnpm --filter backend test",
    "test-clingo": "pnpm --filter node-clingo test",
    "test-mcp": "pnpm --filter mcp test",
    "prettier-check": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "cyberismo": "node tools/cli/bin/run",
    "dev": "pnpm --filter backend^... --filter=!app build && pnpm -r --parallel dev",
    "prepare-export": "pnpm --filter backend export && shx cp -r tools/backend/static/api tools/app/public",
    "dev-export": "pnpm prepare-export && cross-env VITE_CYBERISMO_EXPORT=true pnpm --filter app dev",
    "build-docker": "docker build -t cyberismo .",
    "ci:publish": "pnpm --filter !app --filter !@cyberismo/node-clingo publish --access public --no-git-checks",
    "release": "node scripts/release.mjs",
    "check-licenses": "node scripts/check-licenses.mjs"
  }
}
